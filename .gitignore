# Klientská data z revizí portfolií se necommitují
podklady/revize-portfolii/*
!podklady/revize-portfolii/README.md
vystupy/revize-portfolii/*
!vystupy/revize-portfolii/.gitkeep
# E-maily s návrhy portfolia (klientská data)
vystupy/navrhy-portfolia/*
!vystupy/navrhy-portfolia/.gitkeep
__pycache__/

# komerční písmo ZFP akademie (Fedra Sans Pro) – licencované, do repozitáře nepatří
podklady/zfpa-pismo/
# Přání k narozeninám (seznamy klientů a hotové e-maily)
podklady/narozeniny/*
!podklady/narozeniny/README.md
vystupy/narozeniny/*
!vystupy/narozeniny/.gitkeep
